.env
node_modules/
.next/
__pycache__/
.venv/
*.pyc
.pytest_cache/
storage/
**/.sandbox-ca.crt
.claude/security-review/
.fly-credentials
# web/inbox is a deploy-time copy of samples/submissions (see scripts/fly-deploy.sh)
web/inbox/*
!web/inbox/.gitkeep
# web/agent-reports is a deploy-time copy of the review agents' reports for App Tests (see scripts/fly-deploy.sh)
web/agent-reports/*
!web/agent-reports/.gitkeep
.claude/ux-review/
# submissions the app generates when the inbox runs low (stamped YYYYMMDD-HHMM-<slug>)
samples/submissions/2[0-9][0-9][0-9][0-9][0-9][0-9][0-9]-*/
samples/submissions/.tmp-*/

# daily sign-in reports (scripts/login-report.sh): addresses and locations stay on this machine
/reports/

# Finder metadata
.DS_Store
