# Copy to .env. Everything here is optional. Without ANTHROPIC_API_KEY,
# ingestion falls back to deterministic (form-field) extraction only and
# the desk's AI assistant is off (both services read this one key).
ANTHROPIC_API_KEY=
# UW_ANTHROPIC_API_KEY=                            # used when ANTHROPIC_API_KEY is empty (the Claude Code cloud sandbox reserves that name)

# Optional (defaults shown)
# EXTRACTION_MODEL=claude-opus-5-5                 # model the ingestion service uses for Claude extraction
# ASSISTANT_MODEL=claude-opus-5-5                  # model the web app's AI assistant uses
# DISPLAY_TZ=America/New_York                      # time zone for every on-screen timestamp (UX-006)
# SMTP_URL=                                        # outgoing mail for access requests (step 27), e.g. smtps://you%40domain.com:<app password>@smtp.gmail.com:465; unset = requests are kept, not emailed
# MAIL_FROM=                                       # sender, if not the SMTP login itself (Gmail sends only as the account or an alias)
# ACCESS_REQUEST_TO=darryl@siryous.com             # who receives access requests

# Not passed through by docker-compose.yml: set these on the service itself (a Fly secret, or `environment:`
# in a compose override), or in web/.env.local for `next dev`.
# RATING_ADMIN_URL=/admin                          # where the web app's "Rate tables" link points
# SAMPLES_DIR=../../samples                        # sample submissions for the ingestion tests (set in containers)
# PUBLIC_BASE_URL=https://uwdesk-web.fly.dev       # the deployment's public origin(s), comma-separated, canonical first (set in web/fly.toml on Fly; leave unset locally)
# TRUSTED_PROXY=1                                  # believe X-Forwarded-For / X-Real-IP in the sign-in log (only behind a proxy that overwrites them)
# REPORTS_PUBLISH_TOKEN=                           # turns on POST /api/reports/publish, so App Tests on a deployment is current without a push (scripts/reports-publish-setup.sh sets it; unset = off)
# RATING_ADMIN_TOKEN=                              # shared secret web -> rating: the service trusts who is acting only from a caller holding it (a Fly secret)
# BASIC_AUTH_USERS=pat:secret,sam:secret           # sign-in logins, user:password,... (unset locally = no sign-in; scripts/fly-users.sh manages them on Fly)
# BASIC_AUTH_USER=underwriter1                     # or one login: this name with BASIC_AUTH_PASSWORD
# BASIC_AUTH_PASSWORD=
# AUTH_DISABLED=1                                  # on Fly the app refuses everyone until logins are set; this opens it on purpose
# SESSION_SECRET=                                  # signs sign-in sessions (default: derived from the logins, so changing them signs everyone out)
# SEED_HISTORY=50                                  # bound policies to seed at startup through the real pipeline; once they exist it does nothing, so it may stay set
# SUBMISSION_INBOX_DIR=../samples/submissions      # the broker drop folder (default: ../samples/submissions if present, else ./inbox; compose sets /inbox)
# INBOX_AUTO_TOP_UP=0                              # don't generate new submissions when fewer than five are waiting
# KEEP_WARM_INTERVAL_MS=60000                      # how often web pings rating and ingestion so they stay awake; 0 turns it off
# AGENT_REPORTS_DIR=                               # where App Tests reads the review reports (default: ../docs in a checkout, else ./agent-reports)
# MAX_UPLOAD_FILES=20                              # ingestion: most files in one extraction
# MAX_UPLOAD_MB=25                                 # ingestion: most megabytes in one extraction
# MAX_CONCURRENT_EXTRACTIONS=8                    # ingestion: streamed extractions at once; past this, callers get a 503
# Migrations as the owner, when the app runs on the restricted roles in db/roles.sql (default: the app's own connection):
# CUSTOMER_MIGRATION_DATABASE_URL=                 # web, customer database
# POLICY_MIGRATION_DATABASE_URL=                   # web, policy database
# MIGRATION_DATABASE_URL=                          # rating
